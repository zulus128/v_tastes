{
  "expo": {
    "name": "Tastes Local",
    "slug": "tastes-local",
    "scheme": "tastes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.digitalityagency.tastes",
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Tastes uses your contacts to help you find and invite friends."
      }
    },
    "android": {
      "package": "com.digitalityagency.tastes",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#560E0B",
          "image": "./assets/onboarding/logo.png",
          "imageWidth": 189,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tastes to use your location to show nearby places."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tastes to access your photos for your profile picture.",
          "cameraPermission": "Allow Tastes to use your camera for your profile picture."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Tastes to access your contacts to find and invite friends."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B82F29"
        }
      ]
    ]
  }
}
