{
  "expo": {
    "name": "Tastes",
    "slug": "tastes-local",
    "scheme": "tastes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vkassin.tastes",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Tastes uses your contacts to help you find and invite friends."
      },
      "appleTeamId": "7TTF49AXF6"
    },
    "android": {
      "package": "com.vkassin.tastes",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#560E0B",
          "image": "./assets/onboarding/logo.png",
          "imageWidth": 189,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tastes to use your location to show nearby places."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tastes to access your photos for your profile picture.",
          "cameraPermission": "Allow Tastes to use your camera for your profile picture."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Tastes to access your contacts to find and invite friends."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B82F29"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e59da34b-7fa8-4212-b85b-48932ad6da9d"
      }
    },
    "owner": "vvkassin"
  }
}
