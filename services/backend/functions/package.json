{
  "name": "@tastes/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --sourcemap --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:zod",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node lib/scripts/seed.js",
    "comments:recount-seed": "node lib/scripts/recount-seed-comment-counts.js",
    "seed:backfill-dish-photos": "node lib/scripts/backfill-seed-dish-photos.js",
    "search:backfill": "node lib/scripts/backfill-user-search.js",
    "images:backfill": "node lib/scripts/backfill-image-thumbnails.js",
    "users:migrate-private": "node lib/scripts/migrate-private-users.js",
    "staff:set-role": "node lib/scripts/set-staff-role.js"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "google-auth-library": "^10.9.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
