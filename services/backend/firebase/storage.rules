rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource.size < 1536 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validProfileImage() {
      return request.resource.size < 750 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validVenueImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAll(['role'])
        && request.auth.token.role == 'admin';
    }

    function isConversationParticipant(conversationId) {
      let conversation = firestore.get(
        /databases/tastes-eu/documents/conversations/$(conversationId)
      );
      return signedIn()
        && conversation.data.status == 'active'
        && request.auth.uid in conversation.data.participantIds;
    }

    match /profile-images/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validProfileImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /review-images/{uid}/{reviewId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if signedIn() && request.auth.uid == uid && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /chat-images/{uid}/{conversationId}/{fileName} {
      allow get: if isConversationParticipant(conversationId);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && isConversationParticipant(conversationId)
        && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /venue-images/{venueId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validVenueImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
