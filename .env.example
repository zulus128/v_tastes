# Local development uses Firebase Emulator Suite and does not require secrets.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-tastes
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=(default)
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tastes.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-tastes.appspot.com
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo-tastes
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
