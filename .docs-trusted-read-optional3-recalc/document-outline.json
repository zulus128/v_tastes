        "rowIndex": 12,
        "columnIndex": 0
      },
      "text": "Optional 3 — Global Dish",
      "protectedControls": []
    },
    {
      "paragraphId": "P00044",
      "path": "tabs.t.0.body.content[7].table.rows[12].cells[1].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1201,
      "endIndex": 1207,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 266,
        "rowIndex": 12,
        "columnIndex": 1
      },
      "text": "Total",
      "protectedControls": []
    },
    {
      "paragraphId": "P00045",
      "path": "tabs.t.0.body.content[7].table.rows[12].cells[2].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1208,
      "endIndex": 1283,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 266,
        "rowIndex": 12,
        "columnIndex": 2
      },
      "text": "208–368 additional hours beyond Parts 1 and 2, including data work and QA.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[8]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1284,
      "endIndex": 1298,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Scope details",
      "protectedControls": []
    },
    {
      "paragraphId": "P00047",
      "path": "tabs.t.0.body.content[9]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1298,
      "endIndex": 1321,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1 — Crowd Autocomplete",
      "protectedControls": []
    },
    {
      "paragraphId": "P00048",
      "path": "tabs.t.0.body.content[10]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1321,
      "endIndex": 1682,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Venue-specific autocomplete in the review flow. As the user types a dish, Tastes suggests dishes already entered for that venue. The user selects an existing item or adds a new one when no suitable match exists. This reduces spelling variants and duplicate venue dishes, improves dish-level ratings and “top dishes at this venue,” and should be included in v1.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00049",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1682,
      "endIndex": 1698,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2 — Menu Import",
      "protectedControls": []
    },
    {
      "paragraphId": "P00050",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1698,
      "endIndex": 2046,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Import public restaurant menus from web pages or PDFs into structured venue menu items using an LLM-assisted extraction pipeline. The initial scope uses the existing venue list from the Tastes project, filtered to Monaco, Madrid, and London, with approximately 50 priority venues. Imported items should be reviewed or validated before publication.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00051",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2046,
      "endIndex": 2071,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Optional 3 — Global Dish",
      "protectedControls": []
    },
    {
      "paragraphId": "P00052",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2071,
      "endIndex": 2533,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Add a canonical Global Dish entity above restaurant-specific menu items. It stores a canonical name, aliases, translations, category, and optional common ingredients, then links equivalent items across venues. Matching can use spelling, semantics, ingredients, cuisine, preparation method, and images, with confidence thresholds and user confirmation. This enables cross-restaurant search and recommendations such as “Where can I get the best Pizza Margherita?”",
      "protectedControls": []
    },
    {
      "paragraphId": "P00053",
      "path": "tabs.t.0.body.content[15]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2533,
      "endIndex": 2555,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Notes and assumptions",
      "protectedControls": []
    },
    {
      "paragraphId": "P00054",
      "path": "tabs.t.0.body.content[16]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2555,
      "endIndex": 2641,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "All estimates are engineering hours; the conversion basis is 8 hours per working day.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00055",
      "path": "tabs.t.0.body.content[17]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2641,
      "endIndex": 2718,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "Part 1 budget is $300. No budget has been provided for Part 2 or Optional 3.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00056",
      "path": "tabs.t.0.body.content[18]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2718,
      "endIndex": 2880,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "The restaurant list for Menu Import comes from the existing Tastes project; this estimate does not include building or purchasing a separate restaurant database.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00057",
      "path": "tabs.t.0.body.content[19]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2880,
      "endIndex": 3018,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "The Menu Import estimate assumes an MVP based on accessible public web pages and PDFs, not a custom scraper for every restaurant website.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00058",
      "path": "tabs.t.0.body.content[20]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3018,
      "endIndex": 3171,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "LLM, crawling, OCR, storage, proxy, and recurring refresh costs are not included and remain TBD until the number and format of source menus are sampled.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00059",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3171,
      "endIndex": 3275,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "Approximately 50 priority venues is treated as the initial import batch, not a permanent product limit.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00060",
      "path": "tabs.t.0.body.content[22]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3275,
      "endIndex": 3378,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "Imported menu data may require manual review because websites, PDFs, languages, and menu layouts vary.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00061",
      "path": "tabs.t.0.body.content[23]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3378,
      "endIndex": 3586,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "Optional 3 is an expansion beyond Parts 1 and 2. It is not required for venue-level autocomplete or menu import, but it is required for reliable cross-restaurant dish search, comparison, and recommendations.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00062",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3586,
      "endIndex": 3714,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.uj8u00pbl6dl",
      "nestingLevel": null,
      "table": null,
      "text": "Ratings and reviews should remain attached to the restaurant-specific menu item; Optional 3 provides the global grouping layer.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00063",
      "path": "tabs.t.0.body.content[25]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3714,
      "endIndex": 3715,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    }
  ]
