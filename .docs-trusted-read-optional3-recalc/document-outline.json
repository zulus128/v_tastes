        "tableStartIndex": 266,
        "rowIndex": 11,
        "columnIndex": 2
      },
      "text": "16–32 additional hours for ambiguous-match confirmation and future global discovery.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00043",
      "path": "tabs.t.0.body.content[7].table.rows[12].cells[0].content[0]",
      "tabId": "t.0",
